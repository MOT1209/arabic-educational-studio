{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arabic letter lesson (kids_learning.alphabet output)",
  "type": "object",
  "required": ["schema_version", "kind", "letter", "name", "lang", "age_band", "units", "quiz", "review", "duration_report", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "letter_lesson"},
    "letter": {"type": "string", "minLength": 1, "maxLength": 1},
    "name": {"type": "string"},
    "name_en": {"type": "string"},
    "lang": {"enum": ["ar", "en"]},
    "age_band": {"enum": ["child", "preteen", "teen", "adult"]},
    "joining": {"enum": ["dual", "right", "none"]},
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stage", "type", "text", "text_hash", "duration_seconds", "repeat"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-H][0-9]{2}$"},
          "stage": {"enum": ["A", "B", "C", "D", "E", "F", "G", "H"]},
          "type": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "text_hash": {"type": "string"},
          "delivery": {"enum": ["natural", "slow"]},
          "repeat": {"type": "boolean"},
          "repeat_count": {"type": "integer", "minimum": 0},
          "speech_seconds": {"type": "number", "exclusiveMinimum": 0},
          "pause_seconds": {"type": "number", "minimum": 0},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "display": {"type": "object"},
          "picture": {"type": "object", "required": ["concept_en", "illustrable"]}
        }
      }
    },
    "quiz": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "kind", "options", "answer"],
                "properties": {"kind": {"enum": ["which_starts_with", "where_in_word", "sound_choice", "find_letter"]}}}
    },
    "review": {
      "type": "object", "required": ["needs_human_review", "all_approved"],
      "properties": {
        "all_approved": {"type": "boolean"},
        "needs_human_review": {"type": "array", "items": {"type": "object", "required": ["kind", "text", "reason", "status"]}}
      }
    },
    "duration_report": {"type": "object", "required": ["total_seconds"]},
    "warnings": {"type": "array", "items": {"type": "object", "required": ["code"]}}
  }
}
