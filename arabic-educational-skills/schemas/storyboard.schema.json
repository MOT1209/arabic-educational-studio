{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "type": "object",
  "required": [
    "version",
    "shots"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "style_id": {
      "type": "string"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_number",
          "scene_id",
          "shot_type",
          "camera_angle",
          "camera_movement",
          "subject",
          "background",
          "duration_seconds"
        ],
        "properties": {
          "shot_number": {
            "type": "integer",
            "minimum": 1
          },
          "scene_id": {
            "type": "string",
            "pattern": "^scene_\\d{2,3}$"
          },
          "shot_type": {
            "enum": [
              "wide",
              "medium",
              "close_up",
              "extreme_close_up",
              "establishing"
            ]
          },
          "camera_angle": {
            "enum": [
              "eye_level",
              "high",
              "low",
              "over_shoulder",
              "top_down",
              "dutch"
            ]
          },
          "camera_movement": {
            "enum": [
              "static",
              "pan",
              "tilt",
              "zoom",
              "dolly",
              "tracking"
            ]
          },
          "subject": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "lighting": {
            "type": "string"
          },
          "composition": {
            "type": "string"
          },
          "character_position": {
            "type": "string"
          },
          "visual_action": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "transition": {
            "type": "string"
          },
          "required_assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generation_prompt": {
            "type": "string"
          },
          "continuity_notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
